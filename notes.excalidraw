      "isDeleted": false,
      "boundElements": [],
      "updated": 1786093097360,
      "link": null,
      "locked": false,
      "text": "GET --> Read a resource ( Idempotent )\nPOST --> To update a resource\nPUT --> Replace/Update a resource completely\nPATCH --> Update a resource partially\nDELETE --> Delete a resource ( Idempotent )",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "GET --> Read a resource ( Idempotent )\nPOST --> To update a resource\nPUT --> Replace/Update a resource completely\nPATCH --> Update a resource partially\nDELETE --> Delete a resource ( Idempotent )",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "SWy1Ps2TeX_siWO4rWKzy",
      "type": "text",
      "x": -69.05074250942107,
      "y": 811.5485155347815,
