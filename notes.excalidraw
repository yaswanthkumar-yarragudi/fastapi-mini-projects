      "isDeleted": false,
      "boundElements": [],
      "updated": 1786093143576,
      "link": null,
      "locked": false,
      "text": "100 - 199 --> Information responses\n200 - 299 --> Success Response\n300 - 399 --> Redirection Messages\n400 - 499 --> Client Errors\n500 - 600 --> Server Errors ",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "100 - 199 --> Information responses\n200 - 299 --> Success Response\n300 - 399 --> Redirection Messages\n400 - 499 --> Client Errors\n500 - 600 --> Server Errors ",
